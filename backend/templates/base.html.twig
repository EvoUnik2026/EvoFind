{% set rtl = app.request.locale == 'ar' %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}" dir="{{ rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}EvoFind{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap{{ rtl ? '.rtl' : '' }}.min.css">
</head>
<body>
<nav class="navbar navbar-expand-lg bg-body-tertiary mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home', {_locale: app.request.locale}) }}">EvoFind</a>
        <div class="d-flex gap-2 align-items-center">
            {% for l in ['nl', 'en', 'ar'] %}
                {% set route = app.request.attributes.get('_route') %}
                {% if route and route != 'app_logout' %}
                    <a class="btn btn-sm {{ l == app.request.locale ? 'btn-secondary' : 'btn-outline-secondary' }}"
                       href="{{ path(route, app.request.attributes.get('_route_params')|merge({_locale: l})|merge(app.request.query.all)) }}">{{ l|upper }}</a>
                {% endif %}
            {% endfor %}
            <a class="btn btn-sm btn-primary" href="{{ path('app_listing_new', {_locale: app.request.locale}) }}">{{ 'nav.new_listing'|trans }}</a>
            {% if app.user %}
                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_my_listings', {_locale: app.request.locale}) }}">{{ 'nav.my_listings'|trans }}</a>
                {% if is_granted('ROLE_ADMIN') %}<a class="btn btn-sm btn-outline-dark" href="{{ path('admin') }}">Beheer</a>{% endif %}
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_logout') }}">{{ 'nav.logout'|trans }}</a>
            {% else %}
                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_login', {_locale: app.request.locale}) }}">{{ 'nav.login'|trans }}</a>
                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_register', {_locale: app.request.locale}) }}">{{ 'nav.register'|trans }}</a>
            {% endif %}
        </div>
    </div>
</nav>
<main class="container">
    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message|trans }}</div>{% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>
