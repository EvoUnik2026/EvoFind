{% extends 'base.html.twig' %}
{% block body %}
<h1>{{ 'nav.login'|trans }}</h1>
{% if error %}<div class="alert alert-danger">{{ 'user.invalid_credentials'|trans }}</div>{% endif %}
<form method="post" class="col-md-5">
    <div class="mb-3"><label class="form-label">{{ 'user.email'|trans }}</label><input class="form-control" type="email" name="_username" value="{{ last_username }}" required autofocus></div>
    <div class="mb-3"><label class="form-label">{{ 'user.password'|trans }}</label><input class="form-control" type="password" name="_password" required></div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="btn btn-primary">{{ 'nav.login'|trans }}</button>
</form>
{% endblock %}
